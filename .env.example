# Copy to .env for local dev. On Netlify, set the same keys in Site → Environment variables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Single-user mode: app signs in automatically (no login screen)
VITE_SINGLE_USER_EMAIL=your-email@example.com
VITE_SINGLE_USER_PASSWORD=at-least-six-chars
